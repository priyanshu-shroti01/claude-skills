# ══════════════════════════════════════════════════════════════════
# Claude OS — environment template
# Copy to .env and fill in ONLY what you need. NEVER commit .env.
# Every variable here is optional unless a workflow you run needs it.
# ══════════════════════════════════════════════════════════════════

# ── Anthropic ─────────────────────────────────────────────────────
# Only needed for API/SDK usage outside the Claude Code login session.
ANTHROPIC_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────
# Fine-grained PAT with minimum scopes for the repos you work on.
GITHUB_TOKEN=

# ── Figma (Dev Mode MCP) ─────────────────────────────────────────
FIGMA_ACCESS_TOKEN=

# ── Media generation (provider-agnostic — see config/providers/) ──
# Provider ids are resolved in config/providers/media.yaml
MEDIA_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=

# ── Analytics / Search Console (continuous-growth workflow) ──────
GOOGLE_APPLICATION_CREDENTIALS=
ANALYTICS_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# ── Deployment targets (production agent; approval-gated) ────────
STAGING_DEPLOY_HOOK=
PRODUCTION_DEPLOY_HOOK=

# ── Claude OS behavior ───────────────────────────────────────────
# Highest permission level agents may use without asking (0-3).
# Levels 4-5 ALWAYS require explicit human approval. See SECURITY.md.
CLAUDE_OS_MAX_AUTONOMY=3
# Where Claude OS keeps machine-local state (vendor, logs, locks).
CLAUDE_OS_HOME=${HOME}/.claude-os
